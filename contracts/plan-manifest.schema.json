{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only candidate image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_manifest_digest", "new_manifest"],
  "properties": {
    "schema_version": {"const": 1},
    "source_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "new_manifest": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "image_split", "included"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "image_split": {"enum": ["train", "validation", "test"]},
          "included": {"type": "boolean"}
        }
      }
    }
  }
}
